[Unit]
Description=Kiosk Browser
After=multi-user.target app-server.service
Wants=multi-user.target

[Service]
Type=simple
User=kiosk
Group=kiosk
# PAMName=login sets up the systemd user-session (XDG_RUNTIME_DIR, dbus, etc.).
# TTYPath + StandardInput=tty would also claim /dev/tty1 for systemd, which
# conflicts with Xorg's own VT1 acquisition — leave them OFF so xinit owns vt1.
PAMName=login
StandardOutput=journal
StandardError=journal

Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=HOME=/home/kiosk

ExecStart=/home/kiosk/scripts/kiosk.sh

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
